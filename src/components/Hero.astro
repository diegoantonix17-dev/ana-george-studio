---
import { Image } from "astro:assets";
import estudioInterior from "../assets/photos/estudio-interior.jpg";
import { type Locale, t } from "../i18n/strings";
import AgendarButton from "./AgendarButton.astro";

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
---

<section class="bg-primary/25">
	<div
		class="mx-auto grid max-w-[72rem] items-center gap-8 px-4 py-12 md:grid-cols-2 md:py-16"
	>
		<div>
			{/* Sobre el tinte bg-primary/25 (#CFEBE9) el dorado de texto cae a
			    4.01:1 y el gris apagado a 4.24:1 — ambos bajo AA. §7 designa
			    --color-primary-fg como el color de texto sobre superficies
			    primarias; ahí mide 9.66:1. */}
			<p class="text-sm font-medium tracking-wide text-primary-fg uppercase">
				{t(locale, "hero.eyebrow")}
			</p>
			<h1 class="mt-3 font-display text-[2.75rem] leading-[1.1] md:text-[4rem] md:leading-[1.05]">
				{t(locale, "site.name")}
			</h1>
			<p class="mt-2 font-display text-2xl text-primary-fg">
				{t(locale, "hero.tagline")}
			</p>
			<p class="mt-4 max-w-prose text-primary-fg">
				{t(locale, "hero.intro")}
			</p>
			<AgendarButton locale={locale} class="mt-8" />
		</div>

		<Image
			src={estudioInterior}
			alt={t(locale, "hero.photoAlt")}
			widths={[480, 800, 1200]}
			sizes="(min-width: 768px) 50vw, 100vw"
			loading="eager"
			class="rounded-lg shadow-[0_4px_16px_rgba(31,58,61,0.08)]"
		/>
	</div>
</section>
