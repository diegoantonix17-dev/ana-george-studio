---
import { agendarUrl } from "../data/negocio";
import { type Locale, t } from "../i18n/strings";

/**
 * Acción primaria del sitio: agendar cita.
 *
 * Antes apuntaba a WhatsApp; desde el cambio de alcance lleva al sistema de
 * agendado propio (`agendarUrl`). WhatsApp sigue existiendo como contacto
 * secundario en Ubicación y en el footer, pero ya no es un botón de acción.
 *
 * El enlace es genérico —mismo destino desde las 7 instancias, sin parámetros
 * por servicio—. Un puente con el servicio preseleccionado se diseña a
 * propósito más adelante, no aquí.
 */

interface Props {
	locale: Locale;
	class?: string;
}

const { locale, class: className = "" } = Astro.props;
---

<a
	href={agendarUrl}
	target="_blank"
	rel="noopener noreferrer"
	class:list={[
		"inline-flex items-center gap-2 rounded-lg bg-cta px-6 py-3 font-medium text-cta-fg transition duration-150 ease-out hover:scale-[1.02]",
		className,
	]}
>
	<svg
		width="20"
		height="20"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="2"
		stroke-linecap="round"
		stroke-linejoin="round"
		aria-hidden="true"
		focusable="false"
	>
		<rect x="3" y="4.5" width="18" height="16" rx="2"></rect>
		<path d="M3 9.5h18"></path>
		<path d="M8 2.5v4"></path>
		<path d="M16 2.5v4"></path>
		<path d="m9 14.5 2 2 4-4"></path>
	</svg>
	{t(locale, "cta.agendar")}
</a>
