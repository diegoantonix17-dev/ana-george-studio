---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import ScrollReveal from "../components/ScrollReveal.astro";
import { analyticsActivo, cloudflareToken } from "../data/analytics";
import {
	direccion,
	direccionCompleta,
	redes,
	whatsappNumero,
} from "../data/negocio";
import { type Locale, t } from "../i18n/strings";
import "../styles/global.css";

interface Props {
	locale: Locale;
	title: string;
	description: string;
	/** La 404 no debe indexarse ni aparecer como alternativa de idioma. */
	noindex?: boolean;
}

const { locale, title, description, noindex = false } = Astro.props;

const site = Astro.site ?? new URL("https://ana-george-studio.netlify.app");
const canonical = new URL(Astro.url.pathname, site);
const ogImage = new URL(`/og/og-${locale}.png`, site);

/** Las dos versiones de la misma página, para hreflang. */
const alternates = [
	{ hreflang: "es-MX", href: new URL("/", site).href },
	{ hreflang: "en-US", href: new URL("/en/", site).href },
	{ hreflang: "x-default", href: new URL("/", site).href },
];

const jsonLd = {
	"@context": "https://schema.org",
	"@type": "LocalBusiness",
	name: "Ana George Studio",
	description,
	url: canonical.href,
	image: ogImage.href,
	telephone: `+${whatsappNumero}`,
	address: {
		"@type": "PostalAddress",
		streetAddress: `${direccion.calle}, ${direccion.colonia}`,
		addressLocality: direccion.ciudad,
		addressRegion: direccion.estado,
		postalCode: direccion.codigoPostal,
		addressCountry: direccion.pais,
	},
	openingHours: "Mo-Sa 08:00-18:00",
	priceRange: "$$",
	sameAs: redes.map((red) => red.url),
};
---

<!doctype html>
<html lang={locale}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical.href} />

		{noindex && <meta name="robots" content="noindex, follow" />}
		{
			!noindex &&
				alternates.map((alt) => (
					<link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
				))
		}

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Ana George Studio" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical.href} />
		<meta property="og:image" content={ogImage.href} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={`Ana George Studio — ${direccionCompleta}`} />
		<meta property="og:locale" content={locale === "es" ? "es_MX" : "en_US"} />
		<meta name="twitter:card" content="summary_large_image" />

		<script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />

		{/* Marca que hay JS antes de pintar, para que el estado oculto del
		    scroll-reveal sólo exista si algo puede revelarlo. */}
		<script is:inline>document.documentElement.classList.add("js");</script>
	</head>
	<body class="min-h-screen">
		<a
			href="#main"
			class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-50 focus:rounded-md focus:bg-cta focus:px-4 focus:py-2 focus:text-cta-fg"
		>
			{t(locale, "a11y.skipToContent")}
		</a>

		<Header locale={locale} />

		<main id="main">
			<slot />
		</main>

		<Footer locale={locale} />

		<ScrollReveal />

		{
			/* Se emite sólo cuando `cloudflareToken` deja de ser el placeholder;
			   ver el porqué en src/data/analytics.ts. */
			analyticsActivo && (
				<script
					is:inline
					defer
					src="https://static.cloudflareinsights.com/beacon.min.js"
					data-cf-beacon={JSON.stringify({ token: cloudflareToken })}
				/>
			)
		}
	</body>
</html>
