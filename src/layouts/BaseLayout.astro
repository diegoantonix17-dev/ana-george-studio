---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import ScrollReveal from "../components/ScrollReveal.astro";
import { type Locale, t } from "../i18n/strings";
import "../styles/global.css";

interface Props {
	locale: Locale;
	title: string;
	description: string;
}

const { locale, title, description } = Astro.props;
---

<!doctype html>
<html lang={locale}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		{/* Marca que hay JS antes de pintar, para que el estado oculto del
		    scroll-reveal sólo exista si algo puede revelarlo. */}
		<script is:inline>document.documentElement.classList.add("js");</script>
	</head>
	<body class="min-h-screen">
		<a
			href="#main"
			class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-50 focus:rounded-md focus:bg-cta focus:px-4 focus:py-2 focus:text-cta-fg"
		>
			{t(locale, "a11y.skipToContent")}
		</a>

		<Header locale={locale} />

		<main id="main">
			<slot />
		</main>

		<Footer locale={locale} />

		<ScrollReveal />
	</body>
</html>
